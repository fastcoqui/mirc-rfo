{
  "name": "mirc-rfo-planner",
  "version": "1.0.0",
  "description": "Unofficial MIRC RFO planning aid - static web app generated from the MIRC RFO workbook",
  "scripts": {
    "test": "node --test tests/",
    "e2e": "node tests/e2e.mjs",
    "extract": "python3 tools/extract.py",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "fixtures": "python3 tools/make_fixtures.py",
    "parity": "node tools/parity.mjs",
    "zip": "python3 -c \"import shutil; shutil.make_archive('mirc_rfo_webapp_dist', 'zip', 'dist')\""
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "hyperformula": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^6.4.5"
  },
  "private": true
}
