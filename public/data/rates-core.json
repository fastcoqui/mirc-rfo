 + ZIP->MHA","DTMO BAH ASCII file BAH-ASCII-2026.zip (bahw26.txt, bahwo26.txt, sorted_zipmha26.txt, mhanames26.txt); includes the TX270 update","https://www.travel.dod.mil/Portals/119/Documents/BAH/BAH_Rates_All_Locations_All_Pay_Grades/ASCII/BAH-ASCII-2026.zip","Effective 1 Jan 2026","DTMO blocks automated downloads; the unmodified DTMO zip was retrieved from the Internet Archive capture of that exact URL (8 Oct 2026). 2027 BAH not released (expected mid-Dec 2026) - blank."],["BAH RC/T (BAH Type II, non-locality)","DoD Military Compensation - 2026 Non-Locality BAH Rates (BAH RC/T with / without dependents)","https://militarypay.defense.gov/Portals/3/Documents/Allowances/BAH/PDF_Non-Locality-BAH-Rates/2026-Non-Locality-BAH-Rates.pdf","Effective 1 Jan 2026","Used for RC orders of 30 days or fewer (DTMO BAH FAQ: https://www.travel.dod.mil/Allowances/Basic-Allowance-for-Housing/FAQ/). 2027 blank."],["FICA","Employee and employer each: Social Security (OASDI) 6.2% up to the wage base + Medicare (HI) 1.45%; basic pay only (BAH, BAS and per diem are not FICA wages).","https://www.federalregister.gov/documents/2025/11/03/2025-19763 (2026 base $184,500) \u00b7 https://www.federalregister.gov/documents/2026/10/26/2026-21796 (2027 base $192,300) \u00b7 https://www.ssa.gov/news/en/cola/factsheets/2026.html","Wages paid in 2026 / 2027","Wage-base cap not applied per order (only matters on year-to-date wages)."],["GSA CONUS per diem FY2027 (lodging by month + M&IE, by ZIP)","GSA FY2027 Per Diem ZIP code file + FY2027 per diem rates (standard CONUS $113 lodging / $68 M&IE)","https://www.gsa.gov/system/files/FY2027PerDiemZipCode_Validated090126.xlsx \u00b7 https://www.gsa.gov/system/files/FY2027_PerDiemRates_Validated090126.xlsx","Effective 1 Oct 2026 - 30 Sep 2027","OCONUS not included (flag)."],["GSA CONUS per diem FY2026","GSA FY2026 Per Diem ZIP code file + FY2026 master rates (standard $110 / $68)","https://www.gsa.gov/system/files/FY2026_ZipCodeFile.xlsx \u00b7 https://www.gsa.gov/system/files/FY2026_PerDiemMasterRatesFile.xlsx","Effective 1 Oct 2025 - 30 Sep 2026",null],["First / last day M&IE + incidentals","GSA M&IE breakdown: first and last travel day = 75% of M&IE; incidental expenses $5 (all CONUS tiers)","https://www.gsa.gov/travel/plan-a-trip/per-diem-rates/mie-breakdowns","FY2027",null],["POV mileage (privately owned automobile)","GSA FTR POV mileage reimbursement rate: $0.725/mile (JTR uses the same POC rate)","https://www.gsa.gov/travel/plan-a-trip/transportation-airfare-rates-pov-rates/privately-owned-vehicle-pov-mileage-reimbursement","Effective 1 Jan 2026","CY2027 rate not published as of 31 Oct 2026 - blank; 2026 used with a flag."],["HOW TO UPDATE (yearly paste-in)",null,null,null,null],["Basic pay (AF:BD): fill the next year's block - column AG = year, AH = grade (same 27 grades, same order), AI:BD = the 22 DFAS YOS columns. The key in AF fills itself.",null,null,null,null],["RC/T (BF:BJ): year, grade, without deps, with deps from the Non-Locality BAH Rates PDF. BAS (R:T), FICA (V:Y), POV (AA:AB): add a row for the new year.",null,null,null,null],["BAH locality (BL:CQ): paste DTMO bahwYY.txt rows with BM = year, BO = W; bahwoYY.txt rows with BO = WO (MHA in BN, 27 rates in BQ:CQ in DTMO column order).",null,null,null,null],["ZIP table (DM:DU): add a column 'MHA YYYY' / 'PD FYYYYY' (header text matters) or fill the empty 2027 / FY2028 columns; ZIP column must stay sorted A\u2192Z (Data \u203a Sort).",null,null,null,null],["Per diem (CS:DK): paste the GSA ZIP-code file destinations with CT = FY, CU = DestinationID (0 = standard CONUS rate), CY:DJ = Oct\u2026Sep lodging, DK = M&IE.",null,null,null,null],["Nothing else changes: the estimate picks the year from the order START DATE (per diem by federal FY) and falls back to the latest loaded year with an amber flag.",null,null,null,null]],"calcFormulas":{"E_ON":"=AND(SEL_RANK<>\"\",ISNUMBER(X_START),ISNUMBER(SEL_DAYS))","E_BASEGR":"=IFERROR(INDEX(RT_RANKGR,MATCH(TRIM(SEL_RANK),RT_RANK,0)),\"\")","E_GRADE":"=IF(AND(OR(E_BASEGR=\"O-1\",E_BASEGR=\"O-2\",E_BASEGR=\"O-3\"),E_IN_PRIOR=\"YES\"),E_BASEGR&\"E\",E_BASEGR)","E_GIX":"=IFERROR(MATCH(E_GRADE,RT_GRADES,0),\"\")","E_DAYS":"=IF(ISNUMBER(SEL_DAYS),SEL_DAYS,0)","E_REF":"=IF(ISNUMBER(X_START),X_START,TODAY())","E_YR":"=YEAR(E_REF)","E_FYEAR":"=YEAR(E_REF)+IF(MONTH(E_REF)>=10,1,0)","E_PCSMIN":"=IF(OR(X_DTYPE=\"ADT\",X_DTYPE=\"ADTS\"),140,IF(X_DTYPE=\"ADOS-RC\",181,0))","E_AMD":"=IF(AND(ISNUMBER(E_IN_AMEND),ISNUMBER(X_START),ISNUMBER(X_END)),IF(AND(E_IN_AMEND>X_START,E_IN_AMEND<=X_END),INT(E_IN_AMEND),\"\"),\"\")","E_REM":"=IF(ISNUMBER(E_AMD),X_END-E_AMD+1,E_DAYS)","E_PCS":"=AND(E_ON,E_PCSMIN>0,E_REM>=E_PCSMIN)","E_PCSD":"=IF(E_PCS,E_REM,0)","E_TDYD":"=E_DAYS-E_PCSD","E_SPLIT":"=AND(E_PCS,E_TDYD>0)","E_OTYPE":"=IF(NOT(E_ON),\"\",IF(E_SPLIT,\"TDY \u2192 PCS\",IF(E_PCS,\"PCS\",\"TDY\")))","E_COMM":"=X_ROUTE_IN","E_MLOC":"='RFO Form'!C150=\"YES\"","E_DEPS":"=IF(OR(E_IN_DEPS=\"YES\",E_IN_DEPS=\"NO\"),E_IN_DEPS,\"\")","E_WAIVOK":"=AND(E_DEPS=\"YES\",E_IN_WAIV=\"YES\")","E_HOREX":"=OR(E_COMM,E_MLOC,E_WAIVOK)","E_BAHT1":"=IF(E_TDYD<=0,\"\",IF(E_TDYD<=30,\"RC/T\",\"HOR\"))","E_BAHT2":"=IF(E_PCSD<=0,\"\",IF(E_HOREX,\"HOR\",\"PDS\"))","E_BAHT":"=IF(E_BAHT2=\"\",E_BAHT1,IF(E_BAHT1=\"\",E_BAHT2,E_BAHT1&\" \u2192 \"&E_BAHT2))","E_BAHTXT":"=SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(E_BAHT,\"RC/T\",\"BAH-RC (RC/T)\"),\"HOR\",\"BAH at the HOR rate\"),\"PDS\",\"BAH at the PDS rate\")&IF(E_DEPS=\"\",\"\",\" \u00b7 \"&IF(E_DEPS=\"YES\",\"with\",\"without\")&\" deps\")","E_YOSY":"=IF(ISNUMBER(E_IN_PEBD),IFERROR(DATEDIF(E_IN_PEBD,E_REF,\"y\"),\"\"),\"\")","E_YOSIX":"=IF(ISNUMBER(E_YOSY),MATCH(E_YOSY,RT_YOSMIN,1),IFERROR(MATCH(E_IN_YOS,RT_YOSLBL,0),\"\"))","E_YOSLBL":"=IF(ISNUMBER(E_YOSIX),INDEX(RT_YOSLBL,E_YOSIX),\"\")","E_BPYR":"=IF(COUNTIFS(RT_BPYEAR,E_YR,RT_BPO20,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_BPYEAR*(RT_BPO20>0))))","E_BPMO":"=IFERROR(IF(INDEX(RT_BPV,MATCH(E_BPYR&\"|\"&E_GRADE,RT_BPKEY,0),E_YOSIX)>0,INDEX(RT_BPV,MATCH(E_BPYR&\"|\"&E_GRADE,RT_BPKEY,0),E_YOSIX),\"\"),\"\")","E_BASIC":"=IF(AND(E_ON,ISNUMBER(E_BPMO)),ROUND(E_BPMO/30*E_DAYS,2),0)","E_RCYR":"=IF(COUNTIFS(RT_RCYEAR,E_YR,RT_RCWO,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_RCYEAR*(RT_RCWO>0))))","E_RCMO":"=IFERROR(INDEX(RT_RCV,MATCH(E_RCYR&\"|\"&E_GRADE,RT_RCKEY,0),IF(E_DEPS=\"YES\",2,1))+0,\"\")","E_DZIP":"=IFERROR(IF(LEN(TRIM(E_IN_DZIP&\"\"))=5,VALUE(TRIM(E_IN_DZIP&\"\")),\"\"),\"\")","E_HZIP":"=IFERROR(IF(LEN(TRIM(E_IN_HZIP&\"\"))=5,VALUE(TRIM(E_IN_HZIP&\"\")),\"\"),\"\")","E_BHYR":"=IF(COUNTIFS(RT_BHYEAR,E_YR,RT_BHE1,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_BHYEAR*(RT_BHE1>0))))","E_HZROW":"=IFERROR(MATCH(E_HZIP,RT_ZIP,1),\"\")","E_HZOK":"=IFERROR(INDEX(RT_ZIP,E_HZROW)=E_HZIP,FALSE)","E_HMHA":"=IF(E_HZOK,IFERROR(INDEX(RT_ZTAB,E_HZROW,MATCH(\"MHA \"&E_BHYR,RT_ZHDR,0))&\"\",\"\"),\"\")","E_HMHANAME":"=IF(E_HMHA=\"\",\"\",IFERROR(INDEX(RT_BHNAME,MATCH(E_BHYR&\"|\"&E_HMHA&\"|W\",RT_BHKEY,0)),\"\"))","E_HLOCMO":"=IFERROR(INDEX(RT_BHV,MATCH(E_BHYR&\"|\"&E_HMHA&\"|\"&IF(E_DEPS=\"YES\",\"W\",\"WO\"),RT_BHKEY,0),E_GIX)+0,\"\")","E_DZROW":"=IFERROR(MATCH(E_DZIP,RT_ZIP,1),\"\")","E_DZOK":"=IFERROR(INDEX(RT_ZIP,E_DZROW)=E_DZIP,FALSE)","E_DMHA":"=IF(E_DZOK,IFERROR(INDEX(RT_ZTAB,E_DZROW,MATCH(\"MHA \"&E_BHYR,RT_ZHDR,0))&\"\",\"\"),\"\")","E_DMHANAME":"=IF(E_DMHA=\"\",\"\",IFERROR(INDEX(RT_BHNAME,MATCH(E_BHYR&\"|\"&E_DMHA&\"|W\",RT_BHKEY,0)),\"\"))","E_DLOCMO":"=IFERROR(INDEX(RT_BHV,MATCH(E_BHYR&\"|\"&E_DMHA&\"|\"&IF(E_DEPS=\"YES\",\"W\",\"WO\"),RT_BHKEY,0),E_GIX)+0,\"\")","E_MO1":"=IF(E_BAHT1=\"RC/T\",E_RCMO,IF(E_BAHT1=\"HOR\",E_HLOCMO,\"\"))","E_MO2":"=IF(E_BAHT2=\"PDS\",E_DLOCMO,IF(E_BAHT2=\"HOR\",E_HLOCMO,\"\"))","E_BAHMO":"=IF(E_PCS,E_MO2,E_MO1)","E_BAH":"=IF(AND(E_ON,E_DEPS<>\"\"),ROUND(IF(AND(E_TDYD>0,ISNUMBER(E_MO1)),E_MO1/30*E_TDYD,0)+IF(AND(E_PCSD>0,ISNUMBER(E_MO2)),E_MO2/30*E_PCSD,0),2),0)","E_BASYR":"=IF(COUNTIFS(RT_BASY,E_YR,RT_BASE,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_BASY*(RT_BASE>0))))","E_BASMO":"=IFERROR(INDEX(IF(LEFT(E_GRADE,1)=\"E\",RT_BASE,RT_BASO),MATCH(E_BASYR,RT_BASY,0))+0,\"\")","E_BAS":"=IF(AND(E_ON,E_GRADE<>\"\",ISNUMBER(E_BASMO)),ROUND(E_BASMO/30*E_DAYS,2),0)","E_FYR":"=IF(COUNTIFS(RT_FY,E_YR,RT_FSS,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_FY*(RT_FSS>0))))","E_FICAR":"=IFERROR(INDEX(RT_FSS,MATCH(E_FYR,RT_FY,0))+INDEX(RT_FMED,MATCH(E_FYR,RT_FY,0)),0)","E_FICA_EE":"=ROUND(E_BASIC*E_FICAR,2)","E_FICA_ER":"=IF(E_IN_FICAO=\"NONE\",0,ROUND(E_BASIC*E_FICAR,2))","E_PDON":"=X_ROUTE_OUT","E_PDFY":"=IF(COUNTIFS(RT_PDFY,E_FYEAR,RT_PDMIE,\">0\")>0,E_FYEAR,SUMPRODUCT(MAX(RT_PDFY*(RT_PDMIE>0))))","E_DEST":"=IF(E_DZOK,N(INDEX(RT_ZTAB,E_DZROW,MATCH(\"PD FY\"&E_PDFY,RT_ZHDR,0))),0)","E_MULTI":"=IF(E_DZOK,N(INDEX(RT_ZTAB,E_DZROW,MATCH(\"MULTI FY\"&E_PDFY,RT_ZHDR,0)))=1,FALSE)","E_PDROW":"=IFERROR(MATCH(E_PDFY&\"|\"&E_DEST,RT_PDKEY,0),\"\")","E_PDNAME":"=IF(ISNUMBER(E_PDROW),IF(E_DEST=0,\"Standard CONUS rate\",INDEX(RT_PDNAME,E_PDROW))&IF(INDEX(RT_PDST,E_PDROW)=\"\",\"\",\" \"&INDEX(RT_PDST,E_PDROW)),\"\")","E_LRATE":"=IFERROR(INDEX(RT_PDLODG,E_PDROW,MOD(MONTH(E_REF)-10,12)+1)+0,0)","E_MRATE":"=IFERROR(INDEX(RT_PDMIE,E_PDROW)+0,0)","E_MIED":"=IF(E_IN_MEALP=\"YES\",5.0,E_MRATE)","E_NIGHTS":"=IF(E_SPLIT,E_TDYD,MAX(E_TDYD-1,0))","E_PDOK":"=AND(E_ON,E_PDON,E_DZIP<>\"\",E_TDYD>0)","E_LODGT":"=IF(AND(E_PDOK,E_IN_LODGP<>\"YES\"),ROUND(E_NIGHTS*E_LRATE,2),0)","E_MIET":"=IF(E_PDOK,ROUND(IF(E_SPLIT,0.75*E_MIED+(E_TDYD-1)*E_MIED,IF(E_TDYD=1,0.75*E_MIED,(E_TDYD-2)*E_MIED+2*0.75*E_MIED)),2),0)","E_TRAV":"=IFERROR(MAX(0,INT(N(E_IN_TRAV))),0)","E_LEGS":"=IF(E_PCS,IF(E_SPLIT,1,2),0)","E_TRVON":"=AND(E_PCS,E_PDON,E_TRAV>0)","E_STDROW":"=IFERROR(MATCH(E_PDFY&\"|0\",RT_PDKEY,0),\"\")","E_SLRATE":"=IFERROR(INDEX(RT_PDLODG,E_STDROW,MOD(MONTH(E_REF)-10,12)+1)+0,0)","E_SMRATE":"=IFERROR(INDEX(RT_PDMIE,E_STDROW)+0,0)","E_LODGTR":"=IF(E_TRVON,ROUND(E_LEGS*MAX(E_TRAV-1,0)*E_SLRATE,2),0)","E_MIETR":"=IF(E_TRVON,ROUND(E_LEGS*IF(E_TRAV=1,0.75*E_SMRATE,(E_TRAV-2)*E_SMRATE+2*0.75*E_SMRATE),2),0)","E_LODG":"=E_LODGT+E_LODGTR","E_MIE":"=E_MIET+E_MIETR","E_MILES":"=IFERROR(MAX(0,N(E_IN_MILES)),0)","E_POVYR":"=IF(COUNTIFS(RT_POVY,E_YR,RT_POVR,\">0\")>0,E_YR,SUMPRODUCT(MAX(RT_POVY*(RT_POVR>0))))","E_POVR":"=IFERROR(INDEX(RT_POVR,MATCH(E_POVYR,RT_POVY,0))+0,\"\")","E_MILE":"=IF(AND(E_ON,ISNUMBER(E_POVR)),ROUND(E_MILES*E_POVR,2),0)","E_TOTAL":"=IF(E_ON,E_BASIC+E_BAH+E_BAS+E_FICA_ER+E_LODG+E_MIE+E_MILE,0)","E_ONOTE":"=IF(NOT(E_ON),\"\",TRIM(IF(X_DTYPE=\"\",\"\u26a0 Pick \u2460 assignment type to apply the PCS / TDY rule. \",\"\")&IF(E_SPLIT,\"\u26a0 AMENDED: \"&E_REM&\" days remain from \"&TEXT(E_AMD,\"DD-MMM-YYYY\")&\" \u2192 PCS from that date, PDS BAH (Note \"&IF(E_PCSMIN=140,1,2)&\"). \",\"\")&IF(AND(ISNUMBER(E_AMD),NOT(E_PCS),E_PCSMIN>0),\"Amended: \"&E_REM&\" days left (< \"&E_PCSMIN&\") \u2192 stays TDY. \",\"\")&IF(AND(E_PCS,E_COMM),\"Commuting distance \u2192 HOR BAH (Note 5). \",\"\")&IF(AND(E_PCS,E_MLOC),\"Several locations (Variation Authorized) \u2192 HOR BAH (Notes 3, 5). \",\"\")&IF(AND(E_PCS,E_WAIVOK),\"DA G1 waiver \u2192 HOR BAH (Note 4). \",\"\")&IF(AND(E_PCS,E_DEPS=\"YES\",NOT(E_HOREX)),\"With dependents a DA G1 waiver can keep HOR BAH. \",\"\")&IF(E_PCS,\"PCS: no per diem except travel days.\",\"\")))","E_FLAGS":"=IF(NOT(E_ON),\"\",IF(E_GRADE=\"\",\"\u26a0 No pay grade for this rank. \",\"\")&IF(NOT(ISNUMBER(E_YOSIX)),\"\u26a0 Enter PEBD or pick YEARS OF SERVICE. \",IF(AND(E_GRADE<>\"\",NOT(ISNUMBER(E_BPMO))),\"\u26a0 DFAS has no \"&E_GRADE&\" rate at \"&E_YOSLBL&\". \",\"\"))&IF(E_BPYR<>E_YR,\"\u26a0 \"&E_YR&\" basic pay not published - \"&E_BPYR&\" table used. \",\"\")&IF(E_BASYR<>E_YR,\"\u26a0 \"&E_YR&\" BAS not published - \"&E_BASYR&\" used. \",\"\")&IF(AND(E_BAHT1=\"RC/T\",E_RCYR<>E_YR),\"\u26a0 \"&E_YR&\" BAH RC/T not published - \"&E_RCYR&\" used. \",\"\")&IF(AND(OR(E_BAHT1=\"HOR\",E_BAHT2<>\"\"),E_BHYR<>E_YR),\"\u26a0 \"&E_YR&\" BAH not published - \"&E_BHYR&\" used. \",\"\")&IF(E_DEPS=\"\",\"\u26a0 Pick DEPENDENTS for BAH. \",\"\")&IF(AND(OR(E_BAHT1=\"HOR\",E_BAHT2=\"HOR\"),E_HMHA=\"\"),\"\u26a0 BAH at the HOR rate needs a valid HOME OF RECORD ZIP. \",\"\")&IF(AND(E_BAHT2=\"PDS\",E_DMHA=\"\"),\"\u26a0 BAH at the PDS rate needs a valid DUTY LOCATION ZIP. \",\"\")&IF(AND(E_PDON,E_TDYD>0,E_DZIP=\"\"),\"\u26a0 Enter the DUTY LOCATION ZIP for per diem. \",\"\")&IF(AND(E_PCS,E_PDON,E_TRAV=0),\"\u26a0 Enter PCS TRAVEL DAYS for the travel per diem. \",\"\")&IF(AND(OR(E_PDOK,E_TRVON),E_PDFY<>E_FYEAR),\"\u26a0 FY\"&E_FYEAR&\" per diem not loaded - FY\"&E_PDFY&\" used. \",\"\")&IF(AND(E_PDOK,E_MULTI),\"\u26a0 ZIP spans more than one GSA per diem area - the higher rate is used; check gsa.gov. \",\"\")&IF(AND(E_MILES>0,E_POVYR<>E_YR),\"\u26a0 \"&E_YR&\" POV rate not published - \"&E_POVYR&\" used. \",\"\")&\"\")","E_ASOF":"=\"ESTIMATE ONLY - finance (DFAS / JTR) determines entitlements.  RATES AS OF / SOURCE: DFAS pay & BAS \"&E_BPYR&\" \u00b7 DTMO BAH \"&E_BHYR&\" (RC/T \"&E_RCYR&\") \u00b7 GSA per diem FY\"&E_PDFY&\" \u00b7 SSA FICA \"&E_FYR&\" \u00b7 GSA POV \"&E_POVYR&\" \u00b7 PCS/TDY: AR 37-104-4 Fig 8-19. Sources: hidden 'Rates' tab.\"","E_R_YOS":"=AND(E_ON,E_GRADE<>\"\",NOT(ISNUMBER(E_YOSIX)))","E_R_PEBD":"=AND(ISNUMBER('RFO Form'!H13),NOT(ISNUMBER(E_YOSY)))","E_R_DEPS":"=AND(E_ON,E_DEPS=\"\")","E_R_DZIP":"=OR(AND(E_ON,OR(E_PDON,E_BAHT2=\"PDS\"),E_DZIP=\"\"),AND(TRIM('RFO Form'!C10&\"\")<>\"\",E_DZIP=\"\"))","E_R_HZIP":"=OR(AND(E_ON,OR(E_BAHT1=\"HOR\",E_BAHT2=\"HOR\"),E_HZIP=\"\"),AND(TRIM('RFO Form'!H9&\"\")<>\"\",E_HZIP=\"\"))","E_R_TRAV":"=AND(E_PCS,E_PDON,TRIM('RFO Form'!C11&\"\")=\"\")","E_R_AMEND":"=AND(ISNUMBER('RFO Form'!C15),ISNUMBER(X_END),OR('RFO Form'!C15<=X_START,'RFO Form'!C15>X_END))"},"headers":{"J":"RANK","K":"GRADE","M":"YOS min (completed yrs)","N":"DFAS YOS column","P":"GRADE ORDER","R":"BAS YEAR","S":"ENLISTED $/mo","T":"OFFICER $/mo","V":"FICA YEAR","W":"SOC SEC rate","X":"MEDICARE rate","Y":"SS WAGE BASE","AA":"POV YEAR","AB":"AUTO $/mile"}}